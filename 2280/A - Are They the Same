t = int(input())
for _ in range(t):
    n,k = map(int,input().split())
    a = list(map(int,input().split()))
    b = list(map(int,input().split()))
    odd_in_a = 0
    odd_in_b = 0
    for i in range(n):
        if a[i]%2==1:
            odd_in_a += 1
        if b[i]%2==1:
            odd_in_b += 1
    even_in_a = n-odd_in_a
    even_in_b = n-odd_in_b
    c = False
    if k%2==0:
        if odd_in_b<=odd_in_a:
            c = True
    else:
        if even_in_b<=even_in_a:
            c = True
    if c:
        print("YES")
    else:
        print("NO")